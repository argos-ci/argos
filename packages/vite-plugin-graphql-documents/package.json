{
  "name": "@argos/vite-plugin-graphql-documents",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "watch-build": "tsdown --watch --silent",
    "check-types": "tsc --noEmit",
    "check-format": "prettier --check --cache --ignore-path=../../.gitignore --ignore-path=../../.prettierignore .",
    "lint": "eslint . --max-warnings 0"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@argos/eslint-config": "workspace:*",
    "@argos/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "catalog:",
    "tsdown": "^0.22.14",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "magic-string": "^1.1.0"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@argos/tsconfig/node/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The CLI runs straight off `src` through Node's type stripping, so it
    // imports its own modules by their real `.ts` names.
    "allowImportingTsExtensions": true
  },
  "exclude": ["node_modules", "eslint.config.mjs"]
}

{
  "name": "@argos/util",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "watch-build": "tsdown --watch --silent",
    "check-types": "tsc --noEmit"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "import": "./dist/*.js",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "devDependencies": {
    "@argos/tsconfig": "workspace:*",
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.0"
  }
}

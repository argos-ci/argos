{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/.claude/worktrees",
    "infra/cdk.out",
    "infra/cloudfront-functions"
  ],
  "rules": {
    "curly": "error",
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    // Oxlint 1.79 replaced the `react/react-compiler` nursery rule with 22
    // category-specific ones, 12 of them in `correctness`. Four of those fire
    // on deliberate patterns rather than on bugs, so they stay off until the
    // code they flag is revisited on its own:
    //
    // - `incompatible-library` flags every call into react-hook-form's
    //   `form.register` / `form.watch` and @tanstack/react-virtual's
    //   `useVirtualizer`. It reports the library, not our use of it.
    // - `refs` flags reading `ref.current` during render, which is the whole
    //   point of usePrevious / usePersistentValue / useLatestTruethyValue.
    // - `immutability` flags ref forwarding (`ref.current = element`) inside
    //   callback refs.
    // - `set-state-in-effect` has five hits worth looking at, but they are
    //   render-loop questions to answer one at a time, not a dependency bump.
    "react/incompatible-library": "off",
    "react/refs": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off",
    "unicorn/no-thenable": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/prefer-snapshot-hint": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.mts", "**/*.test.tsx"],
      "rules": {
        "no-empty-pattern": "off",
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": [
              "expect",
              "expectTypeOf",
              "assert",
              "assertType",
              "expectHttpError",
              "request.**.expect"
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/frontend/**"],
      "excludeFiles": ["apps/frontend/src/ui/Toaster.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "sonner",
                "message": "Import { toast, Toaster } from \"@/ui/Toaster\" instead, it handles theming and emphasizes duplicate toasts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/**/*.ts", "apps/backend/src/**/*.tsx"],
      "excludeFiles": [
        "apps/backend/src/util/paths.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "jsPlugins": ["./tools/oxlint-plugin-argos.js"],
      "rules": {
        "argos/no-module-relative-paths": "error"
      }
    }
  ]
}
